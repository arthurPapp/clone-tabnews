{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "pattern": "/INTERNAL_SECRET_[A-Z0-9]{10,}/g",
            "message": "Encontrado um padrão de credencial interna fictícia. Remova antes do commit!"
          }
        ]
      }
    }
  ]
}
