{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Um projeto criado com o curso.dev para aperfeiçoar minha experiencia dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "postdev": "(trap 'npm run services:stop' INT TERM ; next dev)",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "test": "npm run services:up && npm run services:wait:database && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "posttest": "npm run services:stop",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "async-retry": "1.3.3",
    "dotenv": "17.3.1",
    "dotenv-expand": "11.0.6",
    "next": "^14.2.5",
    "node-pg-migrate": "^7.6.1",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "commitizen": "4.3.2",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "^3.3.3",
    "secretlint": "13.0.7"
  },
  "lint-staged": {
    "*": "secretlint"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
